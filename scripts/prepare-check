#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
check_venv=${HIVE_CHECK_VENV:-"$repo_root/.venv"}
python_command=${HIVE_PYTHON:-python3.12}
if [ ! -x "$check_venv/bin/python" ]; then
  "$python_command" -m venv "$check_venv"
fi
"$check_venv/bin/python" -m pip install --disable-pip-version-check \
  --requirement "$repo_root/requirements-dev.lock"
"$check_venv/bin/python" -m pip install --disable-pip-version-check \
  --no-build-isolation --no-deps --editable "$repo_root"
"$check_venv/bin/python" "$repo_root/scripts/prepare_server_tools.py"
dashboard_node=$(node --version)
required_node="v$(cat "$repo_root/dashboard/.nvmrc")"
if [ "$dashboard_node" != "$required_node" ]; then
  echo "Dashboard checks require Node $required_node; found $dashboard_node." >&2
  exit 1
fi
npm ci --ignore-scripts --no-audit --no-fund --prefix "$repo_root/dashboard"
