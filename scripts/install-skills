#!/usr/bin/env python3
"""Preflight and link Hive roles from a stable checkout."""

import argparse
import os
from pathlib import Path

AGENTS = {"codex": ("CODEX_HOME", ".codex"), "claude": ("CLAUDE_CONFIG_DIR", ".claude")}
ROLES = ("executor", "bead", "warden", "weaver", "sage", "vizier", "justiciar", "archivist", "shared")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", type=Path, default=Path.home() / "hive")
    parser.add_argument("--agent", choices=AGENTS, default="codex")
    parser.add_argument("--dest", type=Path)
    args = parser.parse_args()
    variable, home = AGENTS[args.agent]
    source = args.source.expanduser().resolve()
    default = Path(os.environ.get(variable, str(Path.home() / home))) / "skills"
    destination = (args.dest or default).expanduser().resolve()
    targets = [(source / "skills" / name, destination / name) for name in ROLES]
    for target, link in targets:
        if not target.is_dir():
            parser.error(f"Missing source skill: {target}")
        if link.is_symlink():
            if link.resolve() != target:
                parser.error(f"Conflicting skill link: {link}")
        elif link.exists():
            parser.error(f"Conflicting skill path: {link}")
    destination.mkdir(parents=True, exist_ok=True)
    for target, link in targets:
        if not link.is_symlink():
            link.symlink_to(target, target_is_directory=True)
        print(f"{link} -> {target}")
    invoke = "/" if args.agent == "claude" else "$"
    print(f"Invoke {invoke}executor or {invoke}bead; remove only these links to uninstall.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
